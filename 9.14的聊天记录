const inPath = argValue(argv, '--in')\n  if (!inPath) {\n    console.error(\n      '用法: npx tsx scripts/run-noun-table-supervise.ts --in <file.docuverse.json> [--out-dir ./noun-runs]',\n    )\n    process.exit(1)\n  }\n  const absIn = path.resolve(inPath)\n  if (!fs.existsSync(absIn)) {\n    console.error(`找不到文件: ${absIn}`)\n    process.exit(1)\n  }\n\n  const cfg = loadDualModelConfig()\n  if (!reasonEndpointReady(cfg.reason)) {\n    console.error(\n      '推理 LLM 未就绪。请设置环境变量 DEEPSEEK_API_KEY（可选 DEEPSEEK_BASE_URL）。',\n    )\n    process.exit(1)\n  }\n  console.log(\n    `LLM: model=${cfg.reason.model} base=${cfg.reason.baseUrl.replace(/\\/\\/.*@/, '//')}`,\n  )\n\n  const { bookIndex, label, docId } = loadBookIndexFromDocuverse(absIn)\n  const plains = collectPlainTexts(bookIndex)\n  console.log(\n    `语料: ${label} · docId=${docId} · chunks=${bookIndex.chunks.length} · plains=${plains.length}`,\n  )\n  if (plains.length === 0) {\n    console.error('无可用原文 T（plains 空）')\n    process.exit(1)\n  }\n\n  const maxDictationPasses = Number(argValue(argv, '--max-dictation') ?? 3)\n  const maxMergePasses = Number(argValue(argv, '--max-merge') ?? 3)\n  const concurrency = Number(argValue(argv, '--concurrency') ?? 3)\n  const masksPerGroup = Number(argValue(argv, '--masks-per-group') ?? 2)\n\n  const started = Date.now()\n  const result = await runBookNounS1Dictation({\n    bookIndex,\n    maxDictationPasses,\n    maxMergePasses,\n    concurrency,\n    masksPerGroup,\n    onProgress: (msg) => console.log(`  · ${msg}`),\n  })\n\n  if (!result.ok) {\n    console.error(`建表失败: ${result.note}`)\n    process.exit(1)\n  }\n\n  const report = buildNounSuperviseReport({\n    docId,\n    label,\n    sourcePath: absIn,\n    s0: result.index.s0,\n    s1: result.index.s1,\n    S: result.index.S,\n    plains,\n    dictationPasses: result.dictationPasses ?? [],\n    mergePasses: result.mergePasses ?? [],\n    batchResults: result.batchResults,\n    params: {\n      maxDictationPasses,\n      